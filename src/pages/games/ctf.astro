    .ctf-term::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0, rgba(0,0,0,0) 2px, rgba(0,0,0,0.18) 3px); opacity: 0.5; }
    .ctf-term__bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.8rem 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02); }
    .ctf-term__dot { width: 11px; height: 11px; border-radius: 50%; }
    .ctf-term__dot--r { background: #ff5f57; } .ctf-term__dot--y { background: #febc2e; } .ctf-term__dot--g { background: #28c840; }
