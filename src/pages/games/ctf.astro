    .ctf-term__reset:hover { color: var(--ctf); border-color: var(--ctf); }
    .ctf-term__bar-track { height: 4px; border-radius: 999px; background: var(--dim); margin-top: 1.4rem; overflow: hidden; }
    .ctf-term__bar-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--ctf), var(--ctf-2)); transition: width 0.5s cubic-bezier(0.2,0.8,0.2,1); }

    /* Tools + filters */
    .ctf-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1.4rem; }
