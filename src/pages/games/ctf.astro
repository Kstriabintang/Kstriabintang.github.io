    .ctf-filter:hover { color: var(--text-primary); }
    .ctf-filter.is-active { background: var(--ctf); color: #04231f; border-color: var(--ctf); font-weight: 600; }

    /* Cards */
    .ctf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(31rem, 1fr)); gap: 1.6rem; }
    .ctf-card { position: relative; overflow: hidden; border: 1px solid var(--card-border, rgba(255,255,255,0.08)); background: var(--card-bg, #12121f); border-radius: 14px; padding: 1.7rem; transition: border-color 0.25s, transform 0.25s; }
