    .ctf-term__boot { font-family: var(--font-mono, monospace); font-size: 1.35rem; line-height: 1.7; color: var(--ctf); margin: 0; min-height: 11rem; white-space: pre-wrap; }
    .ctf-term__line { font-family: var(--font-mono, monospace); color: var(--text-secondary); font-size: 1.3rem; }
