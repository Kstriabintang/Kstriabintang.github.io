    .ctf-card__pts { font-size: 1.2rem; color: var(--text-secondary); }
    .ctf-card__check { margin-left: auto; color: var(--ctf); font-weight: 700; opacity: 0; transform: scale(0.5); transition: all 0.3s cubic-bezier(0.2,1.4,0.4,1); }
    .ctf-card.is-solved .ctf-card__check { opacity: 1; transform: scale(1); }
    .ctf-card__title { font-size: var(--text-lg); margin: 0.6rem 0 0.3rem; }
    .ctf-card__prompt { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.5; margin-bottom: 1rem; }

    .ctf-card__puzzle { display: block; width: 100%; text-align: left; position: relative; background: var(--term-bg); border: 1px solid rgba(255,255,255,0.08); border-radius: 9px; padding: 0.85rem 1rem; cursor: copy; margin-bottom: 1rem; }
    .ctf-card__puzzle code { font-family: var(--font-mono, monospace); font-size: 1.2rem; color: var(--ctf); word-break: break-all; line-height: 1.55; display: block; max-height: 7rem; overflow-y: auto; padding-top: 2rem; }
    .ctf-card__copy { position: absolute; top: 0.45rem; right: 0.55rem; font-size: 0.95rem; color: var(--text-secondary); background: rgba(25,211,197,0.14); border: 1px solid rgba(25,211,197,0.3); padding: 0.1rem 0.5rem; border-radius: 5px; pointer-events: none; }

    .ctf-card__media { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .ctf-card__media img { border-radius: 8px; background: #fff; padding: 6px; display: block; }
    .ctf-card__file { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; background: var(--term-bg); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 0.9rem; }
    .ctf-card__thumb { width: 8rem; height: 4.5rem; object-fit: cover; border-radius: 6px; flex-shrink: 0; filter: saturate(0.9); }
    .ctf-card__fileicon { font-size: 2.4rem; width: 4.5rem; text-align: center; flex-shrink: 0; }
    .ctf-card__dl { font-family: var(--font-mono, monospace); font-size: var(--text-sm); color: var(--ctf); text-decoration: none; border: 1px solid rgba(25,211,197,0.4); padding: 0.45rem 0.9rem; border-radius: 8px; transition: all 0.2s; }
    .ctf-card__dl:hover { background: var(--dim); }

    .ctf-card__hint { margin-bottom: 1rem; }
