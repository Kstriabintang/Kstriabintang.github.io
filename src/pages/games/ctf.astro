---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/pages/_tool-page.scss';

const DEVSEC = 'https://devsec.ksatriabintangsamudra.com';

// Flags are KBS{...}. Plaintext flags are NOT in the source — only the puzzle
// (encoded/ciphered or a downloadable artifact) and a SHA-256 of the answer.
const challenges = [
  { id: 'warmup', cat: 'ENCODING', diff: 'intro', pts: 50, title: 'Warm-up', tool: 'base64', type: 'text', prompt: 'Everything starts somewhere. Decode this string.', puzzle: 'S0JTe2I0czNfczF4dHlfZjB1cn0=', hint: 'Trailing "=" padding means Base64. DevSec › Base64 › decode.', hash: 'b60aed27dcbfa56b54741126cdf961111415f2a894fdcd53d5e44671bec02c2d' },
  { id: 'hexdump', cat: 'ENCODING', diff: 'intro', pts: 75, title: 'Hex Dump', tool: 'hex', type: 'text', prompt: 'Two characters per byte. Turn the hex back into text.', puzzle: '4b42537b7477305f6e3162626c33735f7033725f627974337d', hint: 'Only 0-9 and a-f = hexadecimal. DevSec › Hex › to text.', hash: 'b75ae08e97d9c275f262de81fe7398f4b3661523198d539325a74f756e820374' },
  { id: 'thirty-two', cat: 'ENCODING', diff: 'easy', pts: 100, title: 'Thirty-Two', tool: 'base32', type: 'text', prompt: 'Like Base64, but upper-case and chunkier.', puzzle: 'JNBFG63UNAYXE5DZL52HOMC7MNUDI4TTPU======', hint: 'A-Z and 2-7 with "=" padding = Base32. DevSec › Base32.', hash: '6f07cf454fabd9238d63b3685d6c1b594e088df54408d61bd97797f3c6afcb1a' },
  { id: 'ones-zeros', cat: 'ENCODING', diff: 'easy', pts: 100, title: 'Ones & Zeros', tool: 'numbase', type: 'text', prompt: 'Eight bits make a byte. Read the machine.', puzzle: '01001011 01000010 01010011 01111011 01100101 00110001 01100111 01101000 01110100 01011111 01100010 00110001 01110100 01110011 01011111 00110000 01101110 01100101 01011111 01100010 01111001 01110100 01100101 01111101', hint: 'Groups of eight 1s and 0s = binary ASCII. DevSec › Number base (binary→text).', hash: '4c2dffd41860de8016f5486c72c42cfe212cd4ac34a8e9dea89a7694c952d12f' },
  { id: 'xorcist', cat: 'CRYPTO', diff: 'medium', pts: 175, title: 'The XORcist', tool: 'xor', type: 'text', prompt: 'Hex ciphertext, XORed byte-by-byte with ONE secret byte. Recover the text.', puzzle: '11180921296b343d36690538232e6905226a28056a226f3b27', hint: 'Single-byte XOR — brute all 256 keys until "KBS{" appears (it is 0x5a). DevSec › XOR Cipher.', hash: '1db83327d31018b9338f8e9902726de1034a174bd4d9b4de9d4d11eb8c50d3c2' },
  { id: 'caesars-ghost', cat: 'CRYPTO', diff: 'medium', pts: 175, title: "Caesar's Ghost", tool: 'cipher', type: 'text', prompt: 'Letters rotated by an UNKNOWN amount. Find the shift.', puzzle: 'RIZ{zo1ma_do0_n03z_ao3y3}', hint: 'Letters shift, digits stay = Caesar. DevSec › Classical Cipher › Caesar (brute), then read the line that starts KBS{.', hash: '765be98bc12828ee3562c4b8b6d5469054cd3df3a999b24965a0a9678618be60' },
  { id: 'vigenere', cat: 'CRYPTO', diff: 'hard', pts: 300, title: 'The Vigenère', tool: 'cipher', type: 'text', prompt: 'A repeating-key cipher over the letters. You need the key.', puzzle: 'QIG{n1zku3fw_p1zo_o_c3r}', hint: 'Vigenère, key "ghost". DevSec › Classical Cipher › Vigenère, type the key, Decode.', hash: 'c4de7b733946c3c799d4f4e46778147bf0a48e9138d9143261f71f307b47eb6d' },
  { id: 'mirror', cat: 'MISC', diff: 'easy', pts: 100, title: 'Mirror', tool: 'text', type: 'text', prompt: 'It reads wrong because it is the wrong way round.', puzzle: '}rev0_3m_p1lf{SBK', hint: 'Reverse the whole string. DevSec › Text › Reverse text.', hash: '0dc1a71841537cfd8049ac38a3fff9af5061ae8208b3023b76e817d220cabab4' },
  { id: 'onion', cat: 'MISC', diff: 'hard', pts: 300, title: 'The Onion', tool: 'base64', type: 'text', prompt: 'Wrapped three times. Peel from the outside in.', puzzle: 'NTg0ZjQ2N2I2MzMzMzM3OTVmNjc3NTMzNWY3OTM0NmMzMzY1NjY3ZA==', hint: 'Base64 → Hex → ROT13 (outer to inner). DevSec › Base64, then Hex, then Classical Cipher › ROT13.', hash: 'e8a00abd5614c8a0929508ac34cf1d8ad6a81864da2cb86458638ac3158e6863' },
  { id: 'scan-me', cat: 'FORENSICS', diff: 'easy', pts: 150, title: 'Scan Me', tool: 'qrdecode', type: 'image', file: '/ctf/scan.png', prompt: 'A black-and-white square holds a secret.', hint: 'Decode the QR code. DevSec › QR decode, or point a phone at it.', hash: '90fbaf6c63ec27e6a3d0157083a9b5124c9a9796435bbca32a1c8a4badb66240' },
  { id: 'say-cheese', cat: 'FORENSICS', diff: 'medium', pts: 250, title: 'Say Cheese', tool: 'fileinspect', type: 'file', file: '/ctf/cheese.png', thumb: '/ctf/cheese.png', prompt: 'Download the photo. The pixels are a decoy — look at what the file carries, not what it shows.', hint: 'Read the PNG metadata/strings. DevSec › File Inspector (metadata), or exiftool / strings.', hash: 'cc9e7dae73ba3ce904122d93f43f50bc8fa624ddebc412d84a01c0301d345ea7' },
  { id: 'the-tail', cat: 'FORENSICS', diff: 'hard', pts: 300, title: 'The Tail', tool: 'fileinspect', type: 'file', file: '/ctf/tail.png', thumb: '/ctf/tail.png', prompt: 'A valid image... with something stapled to the end of the file.', hint: 'Data lives AFTER the IEND marker. strings, binwalk, or DevSec › File Inspector (hex / strings).', hash: 'd06c6a5b4c014b5715081f7e4f8eeb0b7c686f58f4d81bcd017d8cd56e51dfef' },
  { id: 'headless', cat: 'FORENSICS', diff: 'hard', pts: 325, title: 'Headless', tool: 'fileinspect', type: 'file', file: '/ctf/headless.bin', prompt: 'This file will not open — its first eight bytes were wiped. Restore the PNG signature, then read it.', hint: 'The 8-byte PNG signature is wiped. DevSec › File Inspector spots it and offers "Repair PNG header & download" — then open the PNG.', hash: 'e689dd3342865f7346159e2635ea68ba920bc4e090b044a75f832b3987ab7eec' },
  { id: 'whisper', cat: 'STEGO', diff: 'insane', pts: 450, title: 'Whisper', tool: 'fileinspect', type: 'file', file: '/ctf/whisper.png', thumb: '/ctf/whisper.png', prompt: 'The flag is encoded in the least-significant bit of the red channel, left-to-right, top-to-bottom, terminated by a NUL byte.', hint: 'Classic LSB steganography. Extract LSBs of the red channel into bytes (zsteg / stegsolve / a few lines of Python + PIL).', hash: 'cc596921e305531cdb22ecb245142f2cde3709d65f952f8a5f20f8278331d119' },
  { id: 'view-source', cat: 'WEB', diff: 'medium', pts: 200, title: 'Right-Click Denied', tool: 'base64', type: 'web', file: '/ctf/denied.html', prompt: 'Open the page. It blocks right-click and says there is nothing here. It is lying.', hint: 'View source (Ctrl/Cmd+U) or DevTools. A Base64 string sits in a comment — decode it (DevSec › Base64).', hash: '69784554f7d5d295a3dfd139a1c93becda77675144dc781c5bc97a016b357a33' },
  { id: 'spaghetti', cat: 'REVERSING', diff: 'hard', pts: 375, title: 'Spaghetti', tool: null, type: 'file', file: '/ctf/spaghetti.py', prompt: 'A short, deliberately messy Python script. Figure out what it prints — or just run it.', hint: 'Each byte is XORed with 0x2a. Run python3 spaghetti.py, or decode the list yourself.', hash: 'e55bf4042509fb23e8f2a1af1cf2a0052da888a724d5605f6e3c4597d6cbb7c9' },
  { id: 'morse', cat: 'CRYPTO', diff: 'medium', pts: 175, title: 'Dots & Dashes', tool: 'morse', type: 'text', prompt: 'Dots, dashes, and silence. Decode the signal.', puzzle: '-- ----- .-. ... ...-- -.-. ----- -.. ...--', hint: 'International Morse, letters split by spaces. DevSec › Morse › Decode, then lower-case into KBS{...}.', hash: '1a5e9db7f90a58b43693a46d056eb2f342cbbe8ec1bfa073f0f66df2382a5314' },
  { id: 'epitaph', cat: 'STEGO', diff: 'easy', pts: 150, title: 'Epitaph', tool: 'text', type: 'file', file: '/ctf/epitaph.txt', prompt: 'A caretaker log, water-damaged. The words say nothing — but the lines do.', hint: 'Acrostic — the FIRST letter of each line spells it. Paste the lines into DevSec › Text › First letters, then lower-case into KBS{...}.', hash: 'cc0416fe400a75b49651da40c7057b4fc8da455f46ad6b23f81a64228264a0e0' },
  { id: 'capture', cat: 'TRAFFIC', diff: 'medium', pts: 225, title: 'Packet Capture', tool: 'base64', type: 'file', file: '/ctf/capture.txt', prompt: 'A captured HTTP exchange. One header is carrying more than it should.', hint: 'Scan every header for Base64 — one token decodes to the flag, the rest are decoys. DevSec › Base64.', hash: '2be06cc174f08d8e581f641108fd92fd5c228fcf7c7a9d2dc7eca326c4ecebf2' },
  { id: 'veils', cat: 'PROGRAMMING', diff: 'hard', pts: 325, title: 'A Dozen Veils', tool: 'base64', type: 'text', prompt: 'Base64, wrapped a dozen times. By hand you will give up; by loop you will not.', puzzle: '', hint: 'Base64 wrapped a dozen times. DevSec › Base64 › tick "Decode repeatedly" to peel every layer at once — or loop base64-decode in Python.', hash: '806cc49a69ce5c2643056aa6e5ba0db56bab3c6ebee9e7fa09deec0c9ad58780' },
];

const tools = [
  { slug: 'base64', label: 'Base64' }, { slug: 'hex', label: 'Hex' }, { slug: 'base32', label: 'Base32' },
  { slug: 'numbase', label: 'Number base' }, { slug: 'text', label: 'Text' }, { slug: 'xor', label: 'XOR Cipher' },
  { slug: 'qrdecode', label: 'QR decode' }, { slug: 'fileinspect', label: 'File Inspector' }, { slug: 'hash', label: 'Hash' },
];
const cats = ['ALL', ...Array.from(new Set(challenges.map((c) => c.cat)))];
const diffs = [
  { k: 'intro', label: 'intro' }, { k: 'easy', label: 'easy' }, { k: 'medium', label: 'medium' },
  { k: 'hard', label: 'hard' }, { k: 'insane', label: 'insane' },
];
const totalPts = challenges.reduce((a, c) => a + c.pts, 0);
const catWords = cats.filter((c) => c !== 'ALL').map((c) => c.toLowerCase()).join(', ');
---

<BaseLayout
  title="Capture the Flag — a terminal CTF"
  description={`A browser capture-the-flag by Ksatria Bintang Samudra: ${challenges.length} challenges across ${catWords} — real files to download and crack. Solve them with the DevSec Toolbox. Runs entirely in your browser.`}
>
  <main class="tool-page ctf-page" data-total-pts={totalPts}>
    <div class="tool-page__container ctf-wrap">

      <!-- Terminal window -->
      <section class="ctf-term" aria-label="CTF terminal">
        <div class="ctf-term__bar">
          <span class="ctf-term__dot ctf-term__dot--r"></span>
          <span class="ctf-term__dot ctf-term__dot--y"></span>
          <span class="ctf-term__dot ctf-term__dot--g"></span>
          <span class="ctf-term__path">kbs@lab: ~/challenges</span>
        </div>
        <div class="ctf-term__body">
          <pre class="ctf-term__boot" id="ctf-boot" aria-hidden="true"></pre>
          <div class="ctf-term__banner" id="ctf-banner" hidden>
            <p class="ctf-term__line"><span class="ctf-term__prompt">$</span> whoami &amp;&amp; cat intro.txt</p>
            <h1 class="ctf-term__title">Capture the <span>Flag</span></h1>
            <p class="ctf-term__desc">
              {challenges.length} challenges — {catWords}. Every flag is
              <code>KBS&#123;…&#125;</code>. Some are strings; some are <strong>real files you download and crack</strong>.
              Solve them with my <a href={DEVSEC} target="_blank" rel="noopener">DevSec Toolbox</a> — or any tool you like
              (<code>strings</code>, <code>exiftool</code>, <code>binwalk</code>, <code>python3</code>).
            </p>
            <div class="ctf-term__hud">
              <span class="ctf-term__stat"><b data-flags>0</b><i>/ {challenges.length} flags</i></span>
              <span class="ctf-term__stat"><b data-points>0</b><i>/ {totalPts} pts</i></span>
              <button class="ctf-term__reset" type="button" data-reset>./reset</button>
            </div>
            <div class="ctf-term__bar-track"><span class="ctf-term__bar-fill" data-bar></span></div>
          </div>
        </div>
      </section>

      <!-- Rules -->
      <section class="ctf-rules" aria-label="Rules of play">
        <p class="ctf-rules__title">⚠ Rules — honor code, strictly enforced</p>
        <ul class="ctf-rules__list">
          <li><b>No AI.</b> No ChatGPT, Claude, Copilot, Gemini or any model to find, decode, explain or hint a flag. That defeats the entire point.</li>
          <li><b>No shortcuts.</b> Don't look up, share, or ask anyone for flags or write-ups. Solve it yourself.</li>
          <li><b>Tools, not answers.</b> Use the toolbox below and your own analysis — <code>strings</code>, <code>python3</code>, a hex editor, your brain.</li>
          <li>Flags are <b>case-sensitive</b>, format <code>KBS&#123;…&#125;</code>. The certificate at the end certifies that <b>you</b> captured them, unaided.</li>
        </ul>
      </section>

      <!-- Tools -->
      <section class="ctf-tools" aria-label="Toolbox">
        <span class="ctf-tools__label">Solve with my tools →</span>
        {tools.map((t) => (
          <a class="ctf-tool" href={`${DEVSEC}/${t.slug}/`} target="_blank" rel="noopener">{t.label}</a>
        ))}
      </section>

      <!-- Filters -->
      <section class="ctf-filters" aria-label="Filter by category">
        {cats.map((c, i) => (
          <button class={`ctf-filter${i === 0 ? ' is-active' : ''}`} type="button" data-filter={c}>
            {c === 'ALL' ? 'All' : c.toLowerCase()}
          </button>
        ))}
      </section>

      <!-- Challenges -->
      <div class="ctf-grid" id="ctf-grid">
        {challenges.map((c) => (
          <article class="ctf-card" data-id={c.id} data-cat={c.cat} data-hash={c.hash} data-pts={c.pts} data-diff={c.diff}>
            <div class="ctf-card__glow" aria-hidden="true"></div>
            <header class="ctf-card__top">
              <span class="ctf-card__cat">{c.cat}</span>
              <span class={`ctf-card__diff ctf-card__diff--${c.diff}`}>{c.diff}</span>
              <span class="ctf-card__pts">{c.pts}</span>
              <span class="ctf-card__check" data-check aria-hidden="true">✓</span>
            </header>
            <h2 class="ctf-card__title">{c.title}</h2>
            <p class="ctf-card__prompt">{c.prompt}</p>

            {c.type === 'text' && (
              <button class="ctf-card__puzzle" type="button" data-copy title="Click to copy">
                <code>{c.puzzle}</code>
                <span class="ctf-card__copy" data-copy-label>copy</span>
              </button>
            )}

            {c.type === 'image' && (
              <div class="ctf-card__media">
                <img src={c.file} alt="QR code challenge" width="180" height="180" loading="lazy" decoding="async" />
                <a class="ctf-card__dl" href={c.file} download>download .png ↓</a>
              </div>
            )}

            {c.type === 'file' && (
              <div class="ctf-card__file">
                {c.thumb && <img class="ctf-card__thumb" src={c.thumb} alt="" width="240" height="135" loading="lazy" decoding="async" />}
                {!c.thumb && <div class="ctf-card__fileicon" aria-hidden="true">{c.file.endsWith('.py') ? '🐍' : c.file.endsWith('.bin') ? '⛓' : '📄'}</div>}
                <a class="ctf-card__dl" href={c.file} download>download {c.file.split('/').pop()} ↓</a>
              </div>
            )}

            {c.type === 'web' && (
              <div class="ctf-card__file">
                <div class="ctf-card__fileicon" aria-hidden="true">🌐</div>
                <a class="ctf-card__dl" href={c.file} target="_blank" rel="noopener">open {c.file.split('/').pop()} ↗</a>
              </div>
            )}

            <details class="ctf-card__hint">
              <summary>man hint</summary>
              <p>{c.hint}</p>
              {c.tool && <a class="ctf-card__open-tool" href={`${DEVSEC}/${c.tool}/`} target="_blank" rel="noopener">→ DevSec › {c.tool}</a>}
            </details>

            <form class="ctf-card__form" data-form novalidate>
              <span class="ctf-card__ps1" aria-hidden="true">flag&gt;</span>
              <input class="ctf-card__input" type="text" name="flag" autocomplete="off" spellcheck="false" placeholder="KBS{...}" aria-label={`Flag for ${c.title}`} />
              <button class="ctf-card__submit" type="submit">submit</button>
            </form>
            <p class="ctf-card__msg" data-msg role="status" hidden></p>
          </article>
        ))}
      </div>

      <div class="ctf-win" data-win hidden>
        <pre class="ctf-win__art">  _  _   _   __  __ _  _ ___ ___
 | || | /_\ |  \/  | \| | __|   \
 | __ |/ _ \| |\/| | .` | _|| |) |
 |_||_/_/ \_\_|  |_|_|\_|___|___/ </pre>
        <p class="ctf-win__title">All {challenges.length} flags captured — <strong data-win-pts>0</strong> pts.</p>
        <p class="ctf-win__sub">Clean sweep across the whole board — {catWords} — with the same toolbox I bring to the real ones.</p>
        <div class="ctf-win__links">
          <a href="https://github.com/Kstriabintang" target="_blank" rel="noopener">GitHub ↗</a>
          <a href={DEVSEC} target="_blank" rel="noopener">DevSec Toolbox ↗</a>
          <a href="/games/">More games →</a>
        </div>
      </div>

      <!-- Certificate -->
      <section class="ctf-cert" id="ctf-cert" aria-label="Completion certificate">
        <p class="ctf-cert__eyebrow">Your reward</p>
        <h2 class="ctf-cert__h2">A certificate worth earning.</h2>
        <p class="ctf-cert__lead">
          Capture all <b>{challenges.length}</b> flags and claim a personalized certificate — scannable, downloadable, yours.
          Below is a live sample issued to <b>Ksatria Bintang Samudra</b>.
        </p>

        <div class="ctf-cert__frame">
          <canvas id="ctf-cert-canvas" class="ctf-cert__canvas" width="1400" height="990" role="img" aria-label="Sample CTF completion certificate for Ksatria Bintang Samudra"></canvas>
        </div>
        <div class="ctf-cert__lock" data-cert-lock>
          <span class="ctf-cert__lock-icon" aria-hidden="true">🔒</span>
          <p><b data-cert-remaining>{challenges.length}</b> flags left to unlock your own — this is a live sample.</p>
        </div>

        <div class="ctf-cert__claim" data-cert-claim hidden>
          <label class="ctf-cert__claim-label" for="ctf-cert-name">Name on the certificate</label>
          <div class="ctf-cert__claim-row">
            <input id="ctf-cert-name" class="ctf-cert__claim-input" type="text" maxlength="42" autocomplete="name" placeholder="Your full name" />
            <button class="ctf-cert__claim-btn" type="button" data-cert-gen>Generate</button>
            <a class="ctf-cert__dl" data-cert-dl hidden download="kbs-lab-ctf-certificate.png">Download PNG ↓</a>
          </div>
          <p class="ctf-cert__disclaimer">A practice certificate — not an accredited credential. Issued for motivation, under the honor code above (no AI, no shared solutions).</p>
        </div>
      </section>
    </div>
  </main>

  <script>
    import QRCode from 'qrcode';
    const KEY = 'ctf-solved-v2';
    const cards = Array.from(document.querySelectorAll('.ctf-card')) as HTMLElement[];
    const flagsEl = document.querySelector('[data-flags]') as HTMLElement;
    const pointsEl = document.querySelector('[data-points]') as HTMLElement;
    const barEl = document.querySelector('[data-bar]') as HTMLElement;
    const winEl = document.querySelector('[data-win]') as HTMLElement;
    const winPtsEl = document.querySelector('[data-win-pts]') as HTMLElement;
    const total = cards.length;
    const totalPts = cards.reduce((a, c) => a + Number(c.dataset.pts || 0), 0);

    const load = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const save = (ids: string[]) => { try { localStorage.setItem(KEY, JSON.stringify(ids)); } catch { /* private mode */ } };

    async function sha256(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    function refreshHud() {
      const solved = cards.filter((c) => c.classList.contains('is-solved'));
      const pts = solved.reduce((a, c) => a + Number(c.dataset.pts || 0), 0);
      if (flagsEl) flagsEl.textContent = String(solved.length);
      if (pointsEl) pointsEl.textContent = String(pts);
      if (barEl) barEl.style.width = `${(solved.length / total) * 100}%`;
      if (solved.length === total) { if (winPtsEl) winPtsEl.textContent = String(totalPts); winEl.hidden = false; }
      else winEl.hidden = true;
      document.dispatchEvent(new CustomEvent('ctf:progress', { detail: { solved: solved.length, total, pts } }));
    }

    function markSolved(card: HTMLElement, persist = true) {
      if (card.classList.contains('is-solved')) return;
      card.classList.add('is-solved');
      const form = card.querySelector('[data-form]') as HTMLFormElement;
      const input = form.querySelector('.ctf-card__input') as HTMLInputElement;
      input.value = 'captured'; input.disabled = true;
      (form.querySelector('.ctf-card__submit') as HTMLButtonElement).disabled = true;
      const msg = card.querySelector('[data-msg]') as HTMLElement;
      msg.hidden = false; msg.textContent = '[ok] flag captured'; msg.className = 'ctf-card__msg is-ok';
      if (persist) { const ids = load(); if (!ids.includes(card.dataset.id!)) { ids.push(card.dataset.id!); save(ids); } }
    }

    const saved = load();
    cards.forEach((c) => { if (saved.includes(c.dataset.id!)) markSolved(c, false); });

    cards.forEach((card) => {
      const form = card.querySelector('[data-form]') as HTMLFormElement;
      const input = form.querySelector('.ctf-card__input') as HTMLInputElement;
      const msg = card.querySelector('[data-msg]') as HTMLElement;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (card.classList.contains('is-solved')) return;
        const guess = input.value.trim();
        if (!guess) return;
        const ok = (await sha256(guess)) === card.dataset.hash;
        if (ok) { markSolved(card); refreshHud(); }
        else {
          msg.hidden = false; msg.textContent = '[fail] not it — check the format KBS{…}'; msg.className = 'ctf-card__msg is-bad';
          card.classList.remove('shake'); void card.offsetWidth; card.classList.add('shake');
        }
      });
      const copyBtn = card.querySelector('[data-copy]') as HTMLButtonElement | null;
      copyBtn?.addEventListener('click', async () => {
        const text = card.querySelector('.ctf-card__puzzle code')?.textContent || '';
        const label = card.querySelector('[data-copy-label]') as HTMLElement;
        try { await navigator.clipboard.writeText(text); label.textContent = 'copied'; setTimeout(() => (label.textContent = 'copy'), 1200); } catch { /* no clipboard */ }
      });
    });

    // Category filter
    const grid = document.getElementById('ctf-grid')!;
    document.querySelectorAll('.ctf-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.ctf-filter').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const f = (btn as HTMLElement).dataset.filter;
        cards.forEach((c) => { c.style.display = (f === 'ALL' || c.dataset.cat === f) ? '' : 'none'; });
      });
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      save([]);
      cards.forEach((c) => {
        c.classList.remove('is-solved');
        const form = c.querySelector('[data-form]') as HTMLFormElement;
        const input = form.querySelector('.ctf-card__input') as HTMLInputElement;
        input.value = ''; input.disabled = false;
        (form.querySelector('.ctf-card__submit') as HTMLButtonElement).disabled = false;
        (c.querySelector('[data-msg]') as HTMLElement).hidden = true;
      });
      refreshHud();
    });

    // Boot sequence → reveal banner
    const boot = document.getElementById('ctf-boot') as HTMLElement;
    const banner = document.getElementById('ctf-banner') as HTMLElement;
    const bootCats = [...new Set(cards.map((c) => (c.dataset.cat || '').toLowerCase()))].join(' · ');
    const lines = [
      'kbs@lab:~$ ./ctf --init',
      `[ok] mounting /challenges ... ${cards.length} found`,
      `[ok] ${bootCats}`,
      '[ok] flag format: KBS{...}  ·  verify: sha-256 (offline)',
      '[ok] ready. good hunting.',
    ];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function finishBoot() { boot.hidden = true; banner.hidden = false; refreshHud(); }
    if (reduce) { boot.hidden = true; banner.hidden = false; refreshHud(); }
    else {
      let li = 0, ci = 0;
      const tick = () => {
        if (li >= lines.length) { setTimeout(finishBoot, 250); return; }
        boot.textContent = lines.slice(0, li).join('\n') + (li ? '\n' : '') + lines[li].slice(0, ci) + '▋';
        ci++;
        if (ci > lines[li].length) { li++; ci = 0; setTimeout(tick, 120); }
        else setTimeout(tick, 11);
      };
      tick();
    }

    // ===== Completion certificate =====
    const certCanvas = document.getElementById('ctf-cert-canvas') as HTMLCanvasElement | null;
    if (certCanvas) {
      const ctx = certCanvas.getContext('2d')!;
      const lockEl = document.querySelector('[data-cert-lock]') as HTMLElement;
      const remainEl = document.querySelector('[data-cert-remaining]') as HTMLElement;
      const claimEl = document.querySelector('[data-cert-claim]') as HTMLElement;
      const nameInput = document.getElementById('ctf-cert-name') as HTMLInputElement;
      const genBtn = document.querySelector('[data-cert-gen]') as HTMLButtonElement;
      const dlLink = document.querySelector('[data-cert-dl]') as HTMLAnchorElement;
      const W = 1400, H = 990;

      const niceDate = () => new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
      const codeFor = async (name: string, date: string, pts: number) =>
        (await sha256(`${name}|${date}|${pts}|kbslab`)).slice(0, 10).toUpperCase().replace(/(.{5})(.{5})/, '$1-$2');

      function wrap(text: string, x: number, y: number, maxW: number, lh: number) {
        const words = text.split(' '); let line = '';
        for (const w of words) {
          const t = line ? line + ' ' + w : w;
          if (ctx.measureText(t).width > maxW && line) { ctx.fillText(line, x, y); line = w; y += lh; }
          else line = t;
        }
        ctx.fillText(line, x, y);
      }

      const GOLD = '#d9ba7c', GOLD2 = '#e8cf9a', TEAL = '#19d3c5', CREAM = '#f3f1ea';
      function flourish(cx: number, y: number, half: number) {
        ctx.strokeStyle = 'rgba(217,186,124,0.65)'; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(cx - half, y); ctx.lineTo(cx - 16, y); ctx.moveTo(cx + 16, y); ctx.lineTo(cx + half, y); ctx.stroke();
        ctx.save(); ctx.translate(cx, y); ctx.rotate(Math.PI / 4); ctx.fillStyle = GOLD; ctx.fillRect(-5, -5, 10, 10); ctx.restore();
      }
      function corner(x: number, y: number, dx: number, dy: number) {
        ctx.strokeStyle = 'rgba(217,186,124,0.8)'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(x, y + dy * 28); ctx.lineTo(x, y); ctx.lineTo(x + dx * 28, y); ctx.stroke();
      }
      function seal(cx: number, cy: number, r: number) {
        ctx.save();
        ctx.strokeStyle = GOLD; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.arc(cx, cy, r, 0, 7); ctx.stroke();
        ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(cx, cy, r - 9, 0, 7); ctx.stroke();
        ctx.strokeStyle = 'rgba(217,186,124,0.55)'; ctx.lineWidth = 1;
        for (let i = 0; i < 44; i++) { const a = i / 44 * Math.PI * 2; ctx.beginPath(); ctx.moveTo(cx + Math.cos(a) * (r - 9), cy + Math.sin(a) * (r - 9)); ctx.lineTo(cx + Math.cos(a) * (r - 5), cy + Math.sin(a) * (r - 5)); ctx.stroke(); }
        ctx.textAlign = 'center';
        ctx.fillStyle = GOLD; ctx.font = '700 18px Georgia, serif'; ctx.fillText('★', cx, cy - 22);
        ctx.fillStyle = GOLD2; ctx.font = '700 30px Georgia, serif'; ctx.fillText('KBS', cx, cy + 8);
        ctx.fillStyle = GOLD; ctx.font = '600 12px ui-monospace, monospace'; ctx.fillText('— LAB —', cx, cy + 30);
        ctx.fillStyle = TEAL;
        ctx.beginPath(); ctx.moveTo(cx - 20, cy + r - 6); ctx.lineTo(cx - 34, cy + r + 28); ctx.lineTo(cx - 10, cy + r + 15); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(cx + 20, cy + r - 6); ctx.lineTo(cx + 34, cy + r + 28); ctx.lineTo(cx + 10, cy + r + 15); ctx.closePath(); ctx.fill();
        ctx.restore();
      }

      async function draw(name: string, flags: number, pts: number, sample: boolean) {
        const date = niceDate();
        const code = await codeFor(name, date, pts);
        const nm = name || 'Anonymous';
        // background
        const g = ctx.createLinearGradient(0, 0, 0, H);
        g.addColorStop(0, '#0e1220'); g.addColorStop(1, '#080b12');
        ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
        const rg = ctx.createRadialGradient(W / 2, 360, 40, W / 2, 360, 980);
        rg.addColorStop(0, 'rgba(25,211,197,0.07)'); rg.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);
        // guilloche watermark
        ctx.save(); ctx.globalAlpha = 0.05; ctx.strokeStyle = GOLD; ctx.lineWidth = 1;
        for (let i = 0; i < 11; i++) { ctx.beginPath(); ctx.arc(W / 2, 430, 110 + i * 24, 0, 7); ctx.stroke(); }
        ctx.restore();
        // borders + corners
        ctx.strokeStyle = GOLD; ctx.lineWidth = 3; ctx.strokeRect(40, 40, W - 80, H - 80);
        ctx.strokeStyle = 'rgba(25,211,197,0.5)'; ctx.lineWidth = 1.5; ctx.strokeRect(54, 54, W - 108, H - 108);
        corner(40, 40, 1, 1); corner(W - 40, 40, -1, 1); corner(40, H - 40, 1, -1); corner(W - 40, H - 40, -1, -1);
        ctx.textAlign = 'center';
        // brand
        ctx.fillStyle = GOLD; ctx.font = '600 20px ui-monospace, SFMono-Regular, Menlo, monospace';
        ctx.fillText('K B S   L A B   ·   C A P T U R E   T H E   F L A G', W / 2, 100);
        // title
        ctx.fillStyle = CREAM; ctx.font = '700 52px Georgia, "Times New Roman", serif';
        ctx.fillText('Certificate of Completion', W / 2, 172);
        flourish(W / 2, 202, 155);
        // certify + name
        ctx.fillStyle = '#9aa3b2'; ctx.font = 'italic 23px Georgia, serif';
        ctx.fillText('This is to certify that', W / 2, 262);
        let fs = 66; ctx.font = `italic 700 ${fs}px Georgia, serif`;
        while (ctx.measureText(nm).width > W - 300 && fs > 30) { fs -= 2; ctx.font = `italic 700 ${fs}px Georgia, serif`; }
        ctx.fillStyle = TEAL; ctx.fillText(nm, W / 2, 338);
        ctx.strokeStyle = 'rgba(217,186,124,0.5)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(W / 2 - 230, 362); ctx.lineTo(W / 2 + 230, 362); ctx.stroke();
        // body
        ctx.fillStyle = '#c7ccd8'; ctx.font = '22px Georgia, serif';
        wrap(`has captured all ${flags} flags of the KBS Lab Capture-the-Flag — spanning cryptography, encoding, forensics, steganography, web and reversing — scoring ${pts} of ${totalPts} points, unaided.`, W / 2, 414, 1000, 33);
        // honor + stats
        ctx.fillStyle = GOLD; ctx.font = '600 18px ui-monospace, Menlo, monospace';
        ctx.fillText('Completed under the honor code — no AI, no shared solutions.', W / 2, 512);
        ctx.fillStyle = '#8891a0'; ctx.font = '17px ui-monospace, Menlo, monospace';
        ctx.fillText(`FLAGS ${flags}/${total}        SCORE ${pts}        CATEGORIES 7`, W / 2, 550);
        // QR → verify URL
        const params = new URLSearchParams({ n: nm, f: String(flags), p: String(pts), d: date, c: code });
        const verifyUrl = `${location.origin}/verify/?${params.toString()}`;
        try {
          const url = await QRCode.toDataURL(verifyUrl, { margin: 1, width: 320, errorCorrectionLevel: 'M', color: { dark: '#0b0e14', light: '#e9f7f4' } });
          const qim = new Image(); qim.src = url; await qim.decode();
          const qs = 140, qx = 150, qy = 700;
          ctx.fillStyle = '#e9f7f4'; ctx.fillRect(qx - 7, qy - 7, qs + 14, qs + 14);
          ctx.strokeStyle = GOLD; ctx.lineWidth = 2; ctx.strokeRect(qx - 7, qy - 7, qs + 14, qs + 14);
          ctx.drawImage(qim, qx, qy, qs, qs);
          ctx.textAlign = 'center'; ctx.fillStyle = '#8891a0'; ctx.font = '14px ui-monospace, Menlo, monospace';
          ctx.fillText('scan to verify', qx + qs / 2, qy + qs + 28);
        } catch (_) { /* qr failed; continue */ }
        // seal
        seal(W / 2, 772, 70);
        // signature (bottom-right)
        ctx.textAlign = 'right';
        ctx.fillStyle = '#eef1f6'; ctx.font = 'italic 34px "Snell Roundhand", "Brush Script MT", Georgia, cursive';
        ctx.fillText('Ksatria Bintang Samudra', W - 150, 758);
        ctx.strokeStyle = 'rgba(255,255,255,0.22)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(W - 150 - 320, 780); ctx.lineTo(W - 150, 780); ctx.stroke();
        ctx.fillStyle = '#8891a0'; ctx.font = '15px ui-monospace, Menlo, monospace';
        ctx.fillText('Ksatria Bintang Samudra', W - 150, 804);
        ctx.fillText('Author · KBS Lab', W - 150, 826);
        ctx.fillText(`Issued ${date}`, W - 150, 860);
        ctx.fillText(`Verify  ${code}`, W - 150, 882);
        // disclaimer
        ctx.textAlign = 'center'; ctx.fillStyle = '#5a6270'; ctx.font = '13px ui-monospace, Menlo, monospace';
        ctx.fillText('Practice certificate — not an accredited credential. Issued by KBS Lab for motivation.', W / 2, H - 32);
        if (sample) {
          ctx.save(); ctx.translate(W / 2, H / 2); ctx.rotate(-Math.PI / 9);
          ctx.fillStyle = 'rgba(25,211,197,0.09)'; ctx.font = '700 170px Georgia, serif'; ctx.textAlign = 'center';
          ctx.fillText('SAMPLE', 0, 55); ctx.restore();
        }
      }

      draw('Ksatria Bintang Samudra', total, totalPts, true);

      function setLock(solved: number) {
        if (remainEl) remainEl.textContent = String(total - solved);
        const done = solved === total;
        if (lockEl) lockEl.hidden = done;
        if (claimEl) claimEl.hidden = !done;
      }
      document.addEventListener('ctf:progress', (e: any) => setLock(e.detail.solved));
      setLock(cards.filter((c) => c.classList.contains('is-solved')).length);

      genBtn?.addEventListener('click', async () => {
        const solved = cards.filter((c) => c.classList.contains('is-solved'));
        if (solved.length !== total) return;
        const pts = solved.reduce((a, c) => a + Number(c.dataset.pts || 0), 0);
        const nm = (nameInput.value || 'Anonymous').trim().slice(0, 42) || 'Anonymous';
        await draw(nm, solved.length, pts, false);
        dlLink.href = certCanvas.toDataURL('image/png');
        dlLink.hidden = false;
      });
    }
  </script>

  <style>
    .ctf-page { --ctf: #19d3c5; --ctf-2: #2bffd6; --dim: rgba(25,211,197,0.14); --term-bg: #080b10; }
