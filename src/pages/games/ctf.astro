    .ctf-card__form:focus-within { border-color: var(--ctf); }
    .ctf-card__ps1 { font-family: var(--font-mono, monospace); color: var(--ctf); font-size: var(--text-sm); }
    .ctf-card__input { flex: 1; min-width: 0; background: transparent; border: none; padding: 0.6rem 0.2rem; color: var(--text-primary); font-family: var(--font-mono, monospace); font-size: var(--text-sm); }
    .ctf-card__input:focus { outline: none; }
    .ctf-card__input:disabled { color: var(--ctf); }
    .ctf-card__submit { font-family: var(--font-mono, monospace); background: var(--ctf); color: #04231f; border: none; border-radius: 8px; padding: 0.55rem 1.1rem; font-weight: 600; cursor: pointer; transition: opacity 0.2s; }
