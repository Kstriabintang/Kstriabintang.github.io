---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../data/site';
import { getPosts, postSlug, formatDate } from '../../components/blog/posts';
import '../../styles/pages/_tool-page.scss';
import '../../styles/pages/_blog.scss';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const all = await getPosts();
const related = all.filter((p) => postSlug(p) !== postSlug(post)).slice(0, 2);

const url = new URL(`/blog/${postSlug(post)}/`, site.url).toString();
const coverAbs = post.data.cover ? new URL(post.data.cover, site.url).toString() : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    author: { '@type': 'Person', name: site.name, url: site.url },
    publisher: { '@type': 'Person', name: site.name, url: site.url },
    ...(coverAbs ? { image: coverAbs } : {}),
    mainEntityOfPage: url,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Notebook', item: new URL('/blog/', site.url).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
if (post.data.faq && post.data.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  } as (typeof jsonLd)[number]);
}
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" image={post.data.cover} jsonLd={jsonLd}>
  <main class="tool-page">
    <article class="tool-page__container blog-post">
      <nav class="tool-page__breadcrumb" aria-label="Breadcrumb">
        <ol class="tool-page__breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog/">Notebook</a></li>
          <li aria-hidden="true">›</li>
          <li>{post.data.category}</li>
        </ol>
      </nav>

      <div class="blog-post__grid">
        <div class="blog-post__main">
      <header class="blog-post__head">
        <div class="blog-post__meta">
          <span class="blog-card__cat">{post.data.category}</span>
          <span class="blog-card__dot" aria-hidden="true">·</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="blog-card__dot" aria-hidden="true">·</span>
          <span>{post.data.readingMinutes} min read</span>
        </div>
        <h1 class="blog-post__title">{post.data.title}</h1>
        <p class="blog-post__lede">{post.data.description}</p>
        <div class="blog-post__tags">
          {post.data.tags.map((t) => <span class="blog-post__tag">{t}</span>)}
        </div>
      </header>

      {post.data.cover && (
        <figure class="blog-post__cover">
          <img src={post.data.cover} alt={`Cover image for ${post.data.title}`} width="1280" height="800" loading="eager" decoding="async" />
        </figure>
      )}

      {post.data.takeaways && post.data.takeaways.length > 0 && (
        <aside class="tldr" aria-label="Key takeaways">
          <p class="tldr__label">⚡ The 30-second version</p>
          <ul class="tldr__list">
            {post.data.takeaways.map((t) => <li>{t}</li>)}
          </ul>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>

      {post.data.faq && post.data.faq.length > 0 && (
        <section class="post-faq" aria-label="Frequently asked questions">
          <h2 class="post-faq__title">FAQ</h2>
          <div class="post-faq__list">
            {post.data.faq.map((f) => (
              <details class="post-faq__item">
                <summary class="post-faq__q">{f.q}</summary>
                <p class="post-faq__a">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <aside class="post-author">
        <img class="post-author__img" src="/images/profile.jpg" alt="Ksatria Bintang Samudra" width="72" height="72" loading="lazy" decoding="async" />
        <div class="post-author__body">
          <p class="post-author__name">Ksatria Bintang Samudra</p>
          <p class="post-author__bio">AI Engineer &amp; founder of Luxavero LLC — I ship production systems for mining, ISPs and small businesses from Pontianak, Indonesia, spec-first and AI-augmented.</p>
          <div class="post-author__links">
            <a href="/#contact">Work with me →</a>
            <a href="/blog/">More writing →</a>
          </div>
        </div>
      </aside>

      <footer class="blog-post__foot">
        <a class="blog-post__back" href="/blog/"><Icon name="arrow-right" size={15} /> All posts</a>
        {related.length > 0 && (
          <div class="blog-post__related">
            <h2 class="blog-post__related-title">Keep reading</h2>
            <div class="blog-post__related-grid">
              {related.map((p) => (
                <a class="blog-card blog-card--sm" href={`/blog/${postSlug(p)}/`}>
                  <span class="blog-card__cat">{p.data.category}</span>
                  <h3 class="blog-card__title">{p.data.title}</h3>
                  <span class="blog-card__more">Read <Icon name="arrow-right" size={14} /></span>
                </a>
              ))}
            </div>
          </div>
        )}
      </footer>
        </div>

        {toc.length > 1 && (
          <aside class="blog-post__toc" aria-label="On this page">
            <p class="blog-post__toc-label">On this page</p>
            <nav>
              <ul>
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </article>
  </main>
</BaseLayout>
