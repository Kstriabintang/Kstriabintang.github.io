---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../data/site';
import { comparisons } from '../../data/comparisons';
import '../../styles/pages/_tool-page.scss';
import '../../styles/pages/_writing.scss';

export function getStaticPaths() {
  return comparisons.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const url = new URL(`/comparisons/${c.slug}/`, site.url).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.title,
    description: c.description,
    datePublished: new Date(c.updated).toISOString(),
    dateModified: new Date(c.updated).toISOString(),
    author: { '@type': 'Person', name: site.name, url: site.url },
    mainEntityOfPage: url,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Comparisons', item: new URL('/comparisons/', site.url).toString() },
      { '@type': 'ListItem', position: 3, name: c.title, item: url },
    ],
  },
];
---

<BaseLayout title={c.title} description={c.description} type="article" jsonLd={jsonLd}>
  <main class="tool-page">
    <article class="tool-page__container writing-article">
      <nav class="tool-page__breadcrumb" aria-label="Breadcrumb">
        <ol class="tool-page__breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/comparisons">Comparisons</a></li>
          <li aria-hidden="true">›</li>
          <li>{c.a} vs {c.b}</li>
        </ol>
      </nav>

      <header class="writing-article__head">
        <span class="writing-card__kind">Comparison</span>
        <h1 class="writing-article__title">{c.a} <span class="writing-card__vs">vs</span> {c.b}</h1>
        <p class="writing-article__lede">{c.intro}</p>
      </header>

      <div class="cmp-table-wrap">
        <table class="cmp-table">
          <thead>
            <tr><th>Dimension</th><th>{c.a}</th><th>{c.b}</th></tr>
          </thead>
          <tbody>
            {c.rows.map((r) => (
              <tr><td class="cmp-table__dim">{r.dim}</td><td>{r.a}</td><td>{r.b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="cmp-when">
        <div class="cmp-when__col">
          <h2>Pick {c.a} when</h2>
          <p>{c.useA}</p>
        </div>
        <div class="cmp-when__col">
          <h2>Pick {c.b} when</h2>
          <p>{c.useB}</p>
        </div>
      </div>

      <div class="cmp-verdict">
        <h2>Verdict</h2>
        <p>{c.verdict}</p>
      </div>

      <footer class="writing-article__foot">
        <a class="writing-article__back" href="/comparisons"><Icon name="arrow-right" size={15} /> All comparisons</a>
      </footer>
    </article>
  </main>
</BaseLayout>
