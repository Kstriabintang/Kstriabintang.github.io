---
// Standalone resume page (own chrome, print-ready) — mirrors the reference resume layout.
import '../styles/pages/_resume.scss';
import { resume } from '../data/resume';
import { site } from '../data/site';

const title = `Resume — ${site.name}`;
const description = `Resume of ${site.name}: AI engineer shipping LLM gateways, payment automation and field apps. Experience, skills and verifiable credentials.`;
const canonical = new URL('/resume/', site.url).toString();
const pdf = '/cv/ksatria-bintang-samudra-resume.pdf';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face { font-family: Montserrat; font-style: normal; font-weight: 400 800; font-display: swap; src: url('/fonts/montserrat.woff2') format('woff2'); }
      @font-face { font-family: Fraunces; font-style: normal; font-weight: 100 900; font-display: swap; src: url('/fonts/fraunces.woff2') format('woff2'); }
      @font-face { font-family: Fraunces; font-style: italic; font-weight: 100 900; font-display: swap; src: url('/fonts/fraunces-italic.woff2') format('woff2'); }
    </style>
    <script is:inline>
      (() => {
        let t = 'dark';
        try { const s = localStorage.getItem('theme'); if (s === 'light' || s === 'dark') t = s; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="bar">
      <a class="bar__back" href="/">
        <span class="bar__back-full">← ksatriabintangsamudra.com</span>
        <span class="bar__back-short">← Home</span>
      </a>
      <div class="bar__actions">
        <button class="theme-toggle" type="button" id="resume-theme" aria-label="Toggle colour theme">
          <span class="theme-toggle__icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          </span>
        </button>
        <a class="btn btn--ghost" href={site.bookCall} target="_blank" rel="noopener">Book a call</a>
        <a class="btn btn--solid" href={pdf} download="Ksatria-Bintang-Samudra-Resume.pdf">↓ Download PDF</a>
      </div>
    </div>

    <main class="resume">
      <header class="head">
        <img class="head__photo" src="/images/profile.jpg" alt={site.name} width="112" height="112" />
        <div class="head__main">
          <h1 class="head__name">{resume.first} <em>{resume.last}</em></h1>
          <p class="head__title">{resume.title} <span class="grad">{resume.titleGrad}</span></p>
          <p class="head__lede">{resume.lede}</p>
          <ul class="head__meta">
            {resume.meta.map((m) => <li class={m.cls}>{m.text}</li>)}
          </ul>
          <ul class="head__contact">
            {resume.contact.map((c) => (
              <li><a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.label}</a></li>
            ))}
          </ul>
        </div>
      </header>

      <section class="stats" aria-label="Highlights">
        {resume.stats.map((s) => (
          <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </section>

      <section class="block">
        <p class="summary">{resume.summary.before} <strong>{resume.summary.strong}</strong>{resume.summary.after}</p>
      </section>

      <section class="block">
        <h2 class="h2">Core skills</h2>
        <div class="skills">
          {resume.skills.map((row) => (
            <div class="skills__row">
              <span class="skills__label">{row.label}</span>
              <span class="skills__chips">{row.chips.map((c) => <span class="chip">{c}</span>)}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="block">
        <h2 class="h2">Experience</h2>
        <div class="timeline">
          {resume.jobs.map((job) => (
            <article class="job">
              <div class="job__head">
                <h3 class="job__role">
                  {job.role} <span class="job__at">·</span> <span class="job__co">{job.company}</span>{' '}
                  <span class="job__clients">{job.clients}</span>
                </h3>
                <span class="job__when">{job.when}</span>
              </div>
              <ul class="job__bullets">
                {job.bullets.map((b) => <li set:html={b.html} />)}
              </ul>
              <div class="job__tags">{job.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </article>
          ))}
        </div>
        <div class="earlier">
          <h3 class="earlier__title">Earlier</h3>
          {resume.earlier.map((e) => (
            <p class="earlier__row"><span set:html={e.html} /> <span class="earlier__when">{e.when}</span></p>
          ))}
        </div>
      </section>

      <section class="block">
        <h2 class="h2">Selected projects</h2>
        {resume.projects.map((p) => (
          <p class="earlier__row"><span set:html={p.html} /> <span class="earlier__when">{p.when}</span></p>
        ))}
      </section>

      <div class="two-col">
        <section class="block">
          <h2 class="h2">Education</h2>
          {resume.education.map((e) => <p class="edu" set:html={e.html} />)}
          <h2 class="h2" style="margin-top: 1.4rem;">Certifications &amp; courses</h2>
          <ul class="awards">
            {resume.certifications.map((c) => <li><span class="awards__ic">🎓</span><span set:html={c.html} /></li>)}
          </ul>
          <ul class="certs" style="margin-top: 1rem;">
            {resume.courses.map((c) => <li set:html={c.html} />)}
          </ul>
        </section>
        <section class="block">
          <h2 class="h2">Languages</h2>
          {resume.languages.map((l) => <p class="edu" set:html={l.html} />)}
        </section>
      </div>

      <footer class="foot">
        <p class="foot__q">“{resume.quote}”</p>
        <div class="foot__actions">
          <a class="btn btn--solid" href={`mailto:${site.email}`}>Email me</a>
          <a class="btn btn--ghost" href="/projects/">See projects</a>
          <a class="btn btn--ghost" href="/">Back to site</a>
        </div>
      </footer>
    </main>

    <script>
      const btn = document.getElementById('resume-theme');
      btn?.addEventListener('click', (e) => {
        const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        const apply = () => {
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch {}
        };
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('theme-transition');
          document.documentElement.style.setProperty('--theme-x', `${(e as MouseEvent).clientX}px`);
          document.documentElement.style.setProperty('--theme-y', `${(e as MouseEvent).clientY}px`);
          doc.startViewTransition(apply);
        } else apply();
      });
    </script>
  </body>
</html>
