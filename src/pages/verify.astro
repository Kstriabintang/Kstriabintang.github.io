---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/_tool-page.scss';
---

<BaseLayout
  title="Verify a certificate — KBS Lab"
  description="Verify a KBS Lab Capture-the-Flag completion certificate. Honor-based practice credential — scan the certificate's QR code to check its details."
>
  <main class="tool-page verify-page">
    <div class="tool-page__container verify-wrap">
      <p class="verify__eyebrow">KBS Lab · certificate verification</p>
      <h1 class="verify__title">Verify a <span>certificate</span></h1>

      <div class="verify__card" id="verify-card" data-state="loading">
        <div class="verify__badge" id="verify-badge" aria-hidden="true"></div>
        <h2 class="verify__status" id="verify-status">Checking…</h2>
        <dl class="verify__details" id="verify-details" hidden></dl>
        <p class="verify__note" id="verify-note"></p>
      </div>

      <form class="verify__paste" id="verify-paste">
        <label class="verify__paste-label" for="verify-input">Have a certificate link? Paste it to check</label>
        <div class="verify__paste-row">
          <input class="verify__paste-input" id="verify-input" type="text" inputmode="url" autocomplete="off" spellcheck="false"
            placeholder="https://ksatriabintangsamudra.com/verify/?n=…" />
          <button class="verify__paste-btn" type="submit">Verify</button>
        </div>
        <p class="verify__paste-err" id="verify-paste-err" role="alert" hidden></p>
      </form>

      <p class="verify__foot">
        This is an <b>honor-based practice credential</b> from the <a href="/games/ctf/">KBS Lab CTF</a> — not an accredited qualification.
        Verification confirms the certificate's details are internally consistent; it is issued on trust (no AI, no shared solutions).
      </p>
      <p class="verify__foot verify__foot--cta"><a class="verify__btn" href="/games/ctf/">← Try the CTF yourself</a></p>
    </div>
  </main>

  <script>
    const card = document.getElementById('verify-card') as HTMLElement;
    const badge = document.getElementById('verify-badge') as HTMLElement;
    const statusEl = document.getElementById('verify-status') as HTMLElement;
    const details = document.getElementById('verify-details') as HTMLElement;
    const note = document.getElementById('verify-note') as HTMLElement;

    async function sha256(text: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('');
    }
    const codeFor = async (name: string, date: string, pts: string) =>
      (await sha256(`${name}|${date}|${pts}|kbslab`)).slice(0, 10).toUpperCase().replace(/(.{5})(.{5})/, '$1-$2');

    function esc(s: string) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    const pasteForm = document.getElementById('verify-paste') as HTMLFormElement;
    const pasteInput = document.getElementById('verify-input') as HTMLInputElement;
    const pasteErr = document.getElementById('verify-paste-err') as HTMLElement;

    async function runVerify(q: URLSearchParams) {
      const name = q.get('n'), flags = q.get('f'), pts = q.get('p'), date = q.get('d'), code = (q.get('c') || '').toUpperCase();

      if (!name || !flags || !pts || !date || !code) {
        card.dataset.state = 'empty';
        badge.textContent = '?'; statusEl.textContent = 'No certificate to check';
        details.hidden = true; details.innerHTML = '';
        note.textContent = 'Scan the QR code on a KBS Lab certificate, or paste its link below.';
        return;
      }

      card.dataset.state = 'loading'; badge.textContent = ''; statusEl.textContent = 'Checking…';
      const expected = await codeFor(name, date, pts);
      const ok = expected === code;

      card.dataset.state = ok ? 'valid' : 'invalid';
      badge.textContent = ok ? '✓' : '✗';
      statusEl.textContent = ok ? 'Verified completion' : 'Could not verify';

      details.hidden = false;
      details.innerHTML = [
        ['Name', name],
        ['Flags', `${flags} of 16 captured`],
        ['Score', `${pts} points`],
        ['Issued', date],
        ['Verify code', code],
      ].map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(String(v))}</dd></div>`).join('');

      note.textContent = ok
        ? 'The certificate details are consistent and its code checks out. Issued on the honor code — no AI, no shared solutions.'
        : 'The verify code does not match these details — the link may have been altered. Ask for a freshly generated certificate.';
    }

    function parseLink(raw: string): URLSearchParams | null {
      raw = raw.trim(); if (!raw) return null;
      let qs = '';
      try { qs = new URL(raw).search; } catch { const i = raw.indexOf('?'); qs = i >= 0 ? raw.slice(i) : raw; }
      if (!qs.startsWith('?')) qs = '?' + qs;
      const p = new URLSearchParams(qs);
      return p.get('c') ? p : null;
    }

    pasteForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      pasteErr.hidden = true;
      const q = parseLink(pasteInput.value);
      if (!q) {
        pasteErr.hidden = false;
        pasteErr.textContent = "That doesn't look like a certificate link — paste the full /verify/ URL.";
        return;
      }
      try { history.replaceState(null, '', '/verify/?' + q.toString()); } catch (_) { /* ignore */ }
      runVerify(q);
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    runVerify(new URLSearchParams(location.search));
  </script>

  <style>
    .verify-page { --ctf: #19d3c5; --gold: #d9ba7c; }
    .verify-wrap { max-width: 44rem; text-align: center; }
    .verify__eyebrow { font-family: var(--font-mono, monospace); font-size: 1.25rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ctf); }
    .verify__title { font-size: var(--text-3xl); margin: 0.3rem 0 2rem; }
    .verify__title span { color: var(--ctf); }
    .verify__card { border: 1px solid rgba(255,255,255,0.1); background: var(--card-bg, #12121f); border-radius: 16px; padding: 2.6rem 2rem; position: relative; overflow: hidden; }
    .verify__card[data-state="valid"] { border-color: rgba(25,211,197,0.5); box-shadow: 0 0 50px rgba(25,211,197,0.1); }
    .verify__card[data-state="invalid"] { border-color: rgba(255,80,110,0.5); }
    .verify__card[data-state="empty"] { border-color: rgba(217,186,124,0.4); }
    .verify__badge { width: 4.6rem; height: 4.6rem; margin: 0 auto 1.1rem; border-radius: 50%; display: grid; place-content: center; font-size: 2.4rem; font-weight: 700; }
    .verify__card[data-state="valid"] .verify__badge { background: rgba(25,211,197,0.14); color: var(--ctf); border: 2px solid var(--ctf); }
    .verify__card[data-state="invalid"] .verify__badge { background: rgba(255,80,110,0.12); color: #ff6b8a; border: 2px solid #ff6b8a; }
    .verify__card[data-state="empty"] .verify__badge { background: rgba(217,186,124,0.12); color: var(--gold); border: 2px solid var(--gold); }
    .verify__card[data-state="loading"] .verify__badge { display: none; }
    .verify__status { font-size: var(--text-xl); }
    .verify__details { margin: 1.8rem auto 0; max-width: 30rem; display: grid; gap: 0.1rem; text-align: left; border-top: 1px solid var(--card-border, rgba(255,255,255,0.08)); }
    .verify__details[hidden] { display: none; }
    .verify__details > div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--card-border, rgba(255,255,255,0.08)); }
    .verify__details dt { color: var(--text-secondary); font-size: var(--text-sm); margin: 0; }
    .verify__details dd { color: var(--text-primary); font-family: var(--font-mono, monospace); font-size: var(--text-sm); margin: 0; text-align: right; }
    .verify__note { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.6; margin-top: 1.6rem; max-width: 30rem; margin-left: auto; margin-right: auto; }
    .verify__paste { margin: 1.8rem auto 0; max-width: 38rem; }
    .verify__paste-label { display: block; font-family: var(--font-mono, monospace); font-size: var(--text-sm); color: var(--text-secondary); margin-bottom: 0.6rem; text-align: center; }
    .verify__paste-row { display: flex; gap: 0.6rem; }
    .verify__paste-input { flex: 1; min-width: 0; background: var(--card-bg, #12121f); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 0.7rem 1rem; color: var(--text-primary); font-family: var(--font-mono, monospace); font-size: var(--text-sm); }
    .verify__paste-input:focus { outline: none; border-color: var(--ctf); }
    .verify__paste-btn { background: var(--ctf); color: #04231f; border: none; border-radius: 10px; padding: 0.7rem 1.4rem; font-weight: 700; cursor: pointer; font-family: var(--font-mono, monospace); }
    .verify__paste-btn:hover { opacity: 0.9; }
    .verify__paste-err { color: #ff6b6b; font-size: var(--text-sm); margin-top: 0.7rem; text-align: center; }
    .verify__paste-err[hidden] { display: none; }

    .verify__foot { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.6; margin-top: 2rem; }
    .verify__foot a { color: var(--ctf); }
    .verify__foot b { color: var(--text-primary); }
    .verify__foot--cta { margin-top: 1.4rem; }
    .verify__btn { display: inline-block; font-family: var(--font-mono, monospace); border: 1px solid rgba(25,211,197,0.4); border-radius: 10px; padding: 0.6rem 1.2rem; text-decoration: none; }
    .verify__btn:hover { background: rgba(25,211,197,0.1); }
  </style>
</BaseLayout>
