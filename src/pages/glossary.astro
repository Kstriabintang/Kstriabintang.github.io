---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { glossary, glossaryGroups } from '../data/glossary';
import '../styles/pages/_tool-page.scss';
import '../styles/pages/_writing.scss';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'AI & Engineering Glossary',
  url: new URL('/glossary/', site.url).toString(),
  hasDefinedTerm: glossary.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.short,
    url: new URL(`/glossary/#${t.slug}`, site.url).toString(),
  })),
};
---

<BaseLayout
  title="Glossary — AI & engineering terms"
  description="Plain-English definitions of AI and engineering terms — LLM, RAG, embeddings, idempotency, row-level security, QRIS, edge computing and more, defined by Ksatria Bintang Samudra."
  jsonLd={jsonLd}
>
  <main class="tool-page">
    <div class="tool-page__container tool-page__container--wide">
      <nav class="tool-page__breadcrumb" aria-label="Breadcrumb">
        <ol class="tool-page__breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li>Glossary</li>
        </ol>
      </nav>
      <header class="tool-page__header">
        <h1>Glossary</h1>
        <p>Plain-English definitions of the AI and engineering terms I use across this site — no jargon for its own sake.</p>
      </header>

      <div class="glossary-filter" data-glossary-filter>
        <input type="search" class="glossary-search" placeholder="Search terms…" aria-label="Search glossary terms" data-glossary-search />
      </div>

      {glossaryGroups.map((group) => (
        <section class="glossary-group" data-glossary-group={group}>
          <h2 class="glossary-group__title">{group}</h2>
          <div class="glossary-list">
            {glossary.filter((t) => t.group === group).map((t) => (
              <article class="glossary-item" id={t.slug} data-term={`${t.term} ${t.short}`.toLowerCase()}>
                <h3 class="glossary-item__term">{t.term}</h3>
                <p class="glossary-item__body">{t.body}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
      <p class="glossary-empty" data-glossary-empty hidden>No terms match that search.</p>
    </div>
  </main>

  <script>
    const search = document.querySelector('[data-glossary-search]') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.glossary-item'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('.glossary-group'));
    const empty = document.querySelector('[data-glossary-empty]') as HTMLElement | null;
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let any = false;
      items.forEach((it) => {
        const show = !q || (it.dataset.term || '').includes(q);
        it.hidden = !show;
        if (show) any = true;
      });
      groups.forEach((g) => {
        const visible = g.querySelectorAll('.glossary-item:not([hidden])').length > 0;
        g.hidden = !visible;
      });
      if (empty) empty.hidden = any;
    });
  </script>
</BaseLayout>
