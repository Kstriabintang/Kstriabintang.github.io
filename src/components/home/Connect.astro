---
import SectionHead from '../ui/SectionHead.astro';
import { site } from '../../data/site';

const socials = [
  { label: 'GitHub', href: site.socials.github },
  { label: 'LinkedIn', href: site.socials.linkedin },
  { label: 'Instagram', href: site.socials.instagram },
  { label: 'WhatsApp', href: site.socials.whatsapp },
];
---

<section class="contact-v2" id="contact">
  <div class="container">
    <SectionHead num="06" lead="Let's" em="connect" />

    <div class="contact-v2__split">
      <div class="sr sr--slide-right" style="transition-delay:200ms">
        <div class="contact-v2__left">
          <h3 class="contact-v2__heading">Let's build something <em>that ships</em> together.</h3>
          <p class="contact-v2__cta-text">
            Whether you need an AI feature wired into a real product, an automation that removes a manual job, or a second pair of eyes on an architecture — I'm in.
          </p>
          <p class="contact-v2__meta">{site.location} · Open to remote work worldwide</p>
          <p class="contact-v2__funfact">Fun fact: I live on the equator — the sun sets at about 6 PM every day of the year.</p>
          <div class="contact-v2__ctas">
            <a class="contact-v2__btn contact-v2__btn--primary" href={site.bookCall} target="_blank" rel="noopener noreferrer">
              Book a call <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="contact-v2__btn contact-v2__btn--ghost" href={`mailto:${site.email}`}>Email me</a>
          </div>
          <div class="contact-v2__socials">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
            ))}
          </div>
        </div>
      </div>

      <div class="sr sr--blur" style="transition-delay:300ms">
        <div class="contact-v2__right">
          <form class="contact-v2__form" data-contact-form novalidate>
            <label class="contact-v2__label" for="contact-name">Name</label>
            <input class="contact-v2__input" id="contact-name" name="name" type="text" placeholder="Your name" autocomplete="name" required maxlength="120" />
            <p class="contact-v2__field-error" data-error-for="name" hidden></p>

            <label class="contact-v2__label" for="contact-email">Email</label>
            <input class="contact-v2__input" id="contact-email" name="email" type="email" placeholder="Your email" autocomplete="email" required maxlength="200" />
            <p class="contact-v2__field-error" data-error-for="email" hidden></p>

            <label class="contact-v2__label" for="contact-message">Message</label>
            <textarea class="contact-v2__textarea" id="contact-message" name="message" placeholder="What's on your mind?" rows="4" required maxlength="5000"></textarea>
            <p class="contact-v2__field-error" data-error-for="message" hidden></p>

            <div class="contact-v2__hp" aria-hidden="true">
              <label for="contact-company">Company</label>
              <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <p class="contact-v2__error" data-form-error role="alert" hidden></p>
            <button class="contact-v2__submit" type="submit" data-submit>
              <span data-submit-label>Send message</span> <span class="arrow" aria-hidden="true">→</span>
            </button>
          </form>

          <div class="contact-v2__success" data-contact-success hidden role="status">
            <svg class="contact-v2__checkmark" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>
            </svg>
            <p class="contact-v2__success-text">Message sent — I'll get back to you within a day or two.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '../../scripts/contact';
  initContactForm();
</script>
