---
import '../styles/global.scss';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/islands/CommandPalette';
import Terminal from '../components/islands/Terminal';
import ChatWidget from '../components/islands/ChatWidget';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Lock pinch/double-tap zoom — only for app-like interactive pages (e.g. the game). */
  lockZoom?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-image.png',
  type = 'website',
  jsonLd,
  noindex = false,
  lockZoom = false,
} = Astro.props;

const viewportContent = lockZoom
  ? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
  : 'width=device-width, initial-scale=1';

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  image: new URL('/images/profile.jpg', site.url).toString(),
  jobTitle: 'AI Engineer',
  hasOccupation: [
    { '@type': 'Occupation', name: 'AI Engineer' },
    { '@type': 'Occupation', name: 'Founder & CEO, Luxavero LLC' },
  ],
  worksFor: { '@type': 'Organization', name: 'Luxavero LLC', url: 'https://luxavero.net' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'STIE Anindya Guna Semarang' },
  description: site.description,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Pontianak', addressRegion: 'West Kalimantan', addressCountry: 'ID' },
  knowsAbout: ['AI Engineering', 'LLM Integration', 'Automation', 'Solutions Architecture', 'Payment Integration', 'Cloudflare Workers', 'Flutter', 'Laravel', 'React'],
  sameAs: [site.socials.github, site.socials.linkedin, site.socials.instagram],
};
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://luxavero.net/#org',
  name: 'Luxavero LLC',
  alternateName: 'Luxavero',
  url: 'https://luxavero.net',
  foundingDate: '2026',
  foundingLocation: { '@type': 'Place', name: 'Wyoming, USA' },
  founder: { '@id': `${site.url}/#person`, '@type': 'Person', name: site.name, url: site.url },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#person` },
};
const ldBlocks = [personLd, orgLd, websiteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={viewportContent} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#02aab0" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette client:idle />
    <Terminal client:idle />
    <ChatWidget client:idle />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
